{
	"name": "jwlutz.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:host": "bun --bun vite dev --host",
		"build:diagrams": "bun --bun scripts/build-diagrams.mjs",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"audit:mobile": "bun run scripts/mobile-audit.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@types/three": "^0.185.1",
		"autoprefixer": "^10.4.23",
		"playwright": "^1.59.1",
		"postcss": "^8.5.6",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@types/js-yaml": "^4.0.9",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"animejs": "^4.5.0",
		"atropos": "^2.0.2",
		"js-yaml": "^4.1.1",
		"motion": "^12.42.2",
		"resend": "^6.17.2",
		"simple-icons": "^16.26.0",
		"three": "^0.182.0"
	}
}
